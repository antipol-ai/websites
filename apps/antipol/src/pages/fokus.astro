  /* === REDUCED MOTION === */
  @media (prefers-reduced-motion: reduce) {
    .bubble-cloud .bubble { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Dot navigation
  document.querySelectorAll('.scroll-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      const target = document.getElementById((dot as HTMLElement).dataset.target!);
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const panels = document.querySelectorAll('.panel[id]');
  const dots = document.querySelectorAll('.scroll-dot');

  const dotObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        dots.forEach(d => d.classList.remove('active'));
        const activeDot = document.querySelector(`.scroll-dot[data-target="${entry.target.id}"]`);
        if (activeDot) activeDot.classList.add('active');
      }
    });
  }, { threshold: 0.4 });

  panels.forEach(panel => dotObserver.observe(panel));

  // Bubble rotation: show 1 at a time, cycle through
  const bubbles = document.querySelectorAll('.bubble-cloud .bubble');
  const CYCLE_INTERVAL = 3200;
  let currentBubble = 0;
  let bubbleTimer: ReturnType<typeof setInterval> | null = null;

  function showBubbles() {
    bubbles.forEach((b, i) => {
      if (i === currentBubble) {
        b.classList.add('bubble-visible');
      } else {
        b.classList.remove('bubble-visible');
      }
    });
    currentBubble = (currentBubble + 1) % bubbles.length;
  }

  // Start cycling when pitch panel is visible
  const pitchPanel = document.getElementById('pitch');
  if (pitchPanel) {
    const bubbleObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          showBubbles();
          if (!bubbleTimer) {
            bubbleTimer = setInterval(showBubbles, CYCLE_INTERVAL);
          }
        } else {
          if (bubbleTimer) {
            clearInterval(bubbleTimer);
            bubbleTimer = null;
          }
        }
      });
    }, { threshold: 0.3 });

    bubbleObserver.observe(pitchPanel);
  }
</script>

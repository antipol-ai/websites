---
/**
 * Detailseite Experiment 01: Mantrify.
 *
 * Dritte Fassung vom 15.08.2026, am Launch-Tag radikal gekuerzt. Die zweite
 * Fassung erzaehlte den kompletten Radical-Empathy-Prozess ueber sieben
 * Kapitel; das war fuer den Live-Gang zu viel und hat die eigentliche Aussage
 * begraben. Diese Fassung hat genau zwei Container:
 *
 *   1. Was ist das Experiment, plus die Teaser-Grafik der Uebersichtsseite
 *      und der Link zur laufenden Microsite.
 *   2. Die Hypothesen, kurz. Ohne Bild, dafuer breiter.
 *
 * Das Muster kommt von der ANTIPOL-Startseite: ein Container je Aussage, er
 * laeuft breit wenn er nur Text traegt, und wird auf die halbe Breite
 * begrenzt sobald rechts ein Bild steht. Bilder sind deshalb quadratisch
 * angelegt, sonst passen sie nicht in die rechte Haelfte.
 *
 * Was hier bewusst NICHT mehr steht: Genese, Prozessschritte, Laufzeit und
 * Schwelle, Arbeitsweise. Der Text dazu ist nicht verloren, er steht in
 * antipol/docs/experimente/mantrify-backstory.md und im Entscheidungs-Log.
 * Wer die Seite spaeter wieder vertieft, holt ihn von dort und nicht aus der
 * Erinnerung.
 *
 * Die Regeln zur Genese bleiben gueltig, sobald wieder davon erzaehlt wird:
 * kein Arbeitgeber, keine Branche, keine Rolle, keine Zeitangabe, die auf eine
 * Anstellung zeigt, keine private Ebene, kein Verursacher.
 */
import AntipolLayout from '../../layouts/AntipolLayout.astro';

/**
 * Adresse der Microsite. Als Konstante, weil sie an zwei Stellen vorkommt und
 * sich noch aendern kann. VOR DEM PUSH PRUEFEN.
 */
const MANTRIFY = 'https://mantrify.antipol.ai';

/**
 * Die drei Hypothesen, gekuerzt aus der zweiten Fassung. Die dritte ist die
 * eigentliche Frage; die erste ist die, bei der wir selbst befangen sind.
 * Diese Einordnung gehoert in den Text und nicht ins Kleingedruckte.
 */
const hypothesen = [
  {
    nr: '01',
    titel: 'Benennen verkürzt',
    text: 'Ein Werkzeug, das den Auslöser benennt, verkürzt den Weg zurück auf die Sachebene. Geprüft haben wir das über Wochen an uns selbst, und für uns funktioniert es deutlich. Wir sind allerdings zwei Menschen, und einer davon hat das Ding gebaut. Das ist ein Grund weiterzumachen und kein Beleg.',
  },
  {
    nr: '02',
    titel: 'Der Weg zurück führt über den Humor',
    text: 'Nicht über den guten Rat. Wer über eine Situation lachen kann, steht schon nicht mehr mittendrin. Die Kante dabei: Solange der Witz der Lage gilt, arbeitet er für den, der ihn liest. Sobald er Personen gilt, wird aus Entlastung Zynismus.',
  },
  {
    nr: '03',
    titel: 'Was für uns funktioniert, funktioniert auch für andere',
    text: 'Das ist die eigentliche Frage und der Grund für die Microsite. Gemessen wird sie am Weitergeben, weil man dafür jemandem etwas zumuten muss: Man gibt nichts weiter, was einen selbst kaltgelassen hat.',
  },
];
---

<AntipolLayout
  title="Mantrify - Experiment 01"
  description="Ein Würfel trägt ein Mantra in fünf Stimmen. Hilft jetzt. Ändert nix."
  activePage="experimente">

  <!-- ============ CONTAINER 1: Was ist das ============ -->
  <section class="panel panel-dark" aria-label="Mantrify - worum es geht">
    <div class="container mit-bild">
      <div class="spalte-text">
        <div class="section-label fade-in">
          <a href="/experimente" class="zurueck">Experimente</a> · 01
        </div>
        <h1 class="fade-in">Mantrify</h1>
        <p class="einzeiler fade-in">Hilft jetzt. Ändert nix.</p>
        <p class="fade-in">Ein Würfel trägt fünf Stimmen zu derselben Lage. Man dreht ihn, bis eine davon trifft. Das Ding löst nichts. Es verkürzt die halbe Stunde nach dem falschen Satz.</p>
        <p class="fade-in">Ein Experiment von ANTIPOL, seit dem 8. August 2026 öffentlich.</p>
        <p class="cta-zeile fade-in fade-in-delay">
          <a class="cta" href={MANTRIFY} rel="noopener">Zum Experiment</a>
        </p>
      </div>
      <div class="spalte-bild fade-in fade-in-delay">
        <img src="/bilder/mantrify-teaser.webp" width="1000" height="1000" loading="eager" decoding="async"
             alt="Eine Teilen-Karte aus Mantrify: das gezeichnete Porträt des Marketing Guru, darunter sein Mantra „Ich bin hier by choice, nicht by default“ und die Zeile Mantrify, hilft jetzt, ändert nix." />
      </div>
    </div>
  </section>

  <!-- ============ CONTAINER 2: Hypothesen ============ -->
  <section class="panel panel-mid" aria-label="Was geprüft wird">
    <div class="container">
      <div class="section-label fade-in">Was wir prüfen</div>
      <h2 class="fade-in">Drei Hypothesen, eine davon unbequem</h2>
      <ol class="hypothesen" role="list">
        {hypothesen.map((h) => (
          <li class="hypothese fade-in">
            <span class="h-nr" aria-hidden="true">{h.nr}</span>
            <div class="h-inhalt">
              <h3>{h.titel}</h3>
              <p>{h.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

</AntipolLayout>

<style>
  /* === PANEL === */
  .panel {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 7rem 4rem 5rem;
    position: relative;
  }
  .panel-dark { background: var(--color-bg); }
  .panel-mid { background: var(--color-surface); border-top: 1px solid rgba(58,58,58,0.4); }
  @media (max-width: 768px) {
    .panel { min-height: auto; padding: 5rem 1.5rem 3.5rem; }
  }

  /* === CONTAINER ===
     Nur Text: laeuft breit. Mit Bild: zwei Spalten, Text links.
     Das ist das Muster der Startseite, hier als echtes Grid statt als
     max-width-Begrenzung, weil rechts ein Bild steht und keine Textur. */
  .container { width: 100%; max-width: 1100px; margin: 0 auto; }
  .container.mit-bild {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4.5rem; align-items: center;
  }
  @media (max-width: 900px) {
    .container.mit-bild { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* === TYPOGRAFIE === */
  .section-label {
    font-family: var(--font-mono);
    font-size: var(--size-label); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-primary-accessible); margin-bottom: 1.2rem;
  }
  .zurueck { color: inherit; text-decoration: none; border-bottom: 1px solid var(--color-text-label); }
  .zurueck:hover { color: var(--color-primary-light); border-bottom-color: var(--color-primary-light); }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600;
    letter-spacing: -0.03em; line-height: 1.05;
    color: var(--color-text-pure); margin: 0 0 0.6rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem); font-weight: 600;
    letter-spacing: -0.025em; line-height: 1.15;
    color: var(--color-text-pure); margin: 0 0 2.4rem;
  }
  .einzeiler {
    font-family: var(--font-display); font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 500; color: var(--color-primary-accessible);
    margin: 0 0 1.4rem; letter-spacing: -0.01em;
  }
  .spalte-text p {
    font-size: var(--size-copy); color: var(--color-text-muted);
    line-height: var(--line-height-copy); margin: 0 0 0.9rem;
  }

  /* === LINK ZUM EXPERIMENT === */
  .cta-zeile { margin: 1.8rem 0 0 !important; }
  .cta {
    display: inline-block;
    font-family: var(--font-display); font-size: var(--size-copy); font-weight: 500;
    color: var(--color-text); background: var(--color-primary);
    text-decoration: none; padding: 0.85rem 2rem; border-radius: 4px;
    transition: background 0.3s ease;
  }
  .cta:hover { background: var(--color-primary-deep); text-decoration: none; }

  /* === BILD ===
     Quadratisch, damit es die rechte Haelfte fuellt ohne Luft zu lassen. */
  .spalte-bild img {
    display: block; width: 100%; height: auto; aspect-ratio: 1 / 1;
    object-fit: cover; border: 1px solid var(--color-border); border-radius: 3px;
  }

  /* === HYPOTHESEN === */
  .hypothesen { list-style: none; margin: 0; padding: 0; max-width: 860px; }
  .hypothese {
    display: grid; grid-template-columns: 3.4rem 1fr; gap: 0 1.4rem;
    padding: 1.5rem 0; border-top: 1px solid var(--color-border);
  }
  .hypothese:last-child { border-bottom: 1px solid var(--color-border); }
  .h-nr {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.6rem; line-height: 1.1; letter-spacing: -0.04em;
    color: var(--color-border);
  }
  .h-inhalt h3 {
    font-family: var(--font-display); font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 600; letter-spacing: -0.015em;
    color: var(--color-text-light); margin: 0 0 0.5rem; line-height: 1.3;
  }
  .h-inhalt p {
    font-size: var(--size-copy); color: var(--color-text-muted);
    line-height: var(--line-height-copy); margin: 0;
  }
  @media (max-width: 600px) {
    .hypothese { grid-template-columns: 2.6rem 1fr; gap: 0 1rem; }
    .h-nr { font-size: 1.25rem; }
  }
</style>

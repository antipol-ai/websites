---
/**
 * Detailseite Experiment 02: Momance.
 *
 * Zweite Fassung vom 15.08.2026, am Launch-Tag radikal gekuerzt. Die erste
 * erzaehlte den kompletten Radical-Empathy-Prozess ueber Methodik plus fuenf
 * Schritte, mit gezeichneten Diagrammen und Belegbildern. Das war fuer den
 * Live-Gang zu tief und hat die eigentliche Aussage begraben. Diese Fassung
 * hat genau zwei Container:
 *
 *   1. Was ist das Experiment, plus die Teaser-Grafik der Uebersichtsseite.
 *      Momance hat noch keinen Link, weil es nicht oeffentlich ist; an der
 *      Stelle steht deshalb der Zustand und kein toter Knopf.
 *   2. Die Hypothesen, kurz. Ohne Bild, dafuer breiter.
 *
 * Das Muster kommt von der ANTIPOL-Startseite: ein Container je Aussage, er
 * laeuft breit wenn er nur Text traegt, und wird auf die halbe Breite
 * begrenzt sobald rechts ein Bild steht.
 *
 * Der Puls wird hier quadratisch gezeigt, auf der Uebersicht quer. Die
 * Komponente nimmt ohnehin die kleinere Seite als Mass, das Seitenverhaeltnis
 * kommt von aussen ueber .puls-quadrat.
 *
 * Was hier bewusst NICHT mehr steht: Methodik, die fuenf Prozessschritte, die
 * Design-Vergleiche und die Belege. Der Text dazu ist nicht verloren, er steht
 * in momance/docs/ und in 16-design-entscheidungen.md. Wer die Seite spaeter
 * wieder vertieft, holt ihn von dort und nicht aus der Erinnerung. Die dafuer
 * gebauten Bilder liegen unter /bilder/momance/.
 */
import AntipolLayout from '../../layouts/AntipolLayout.astro';
import MomancePuls from '../../components/MomancePuls.astro';

/**
 * Die Hypothesen aus der Nutzerbefragung, mit den Original-IDs aus dem
 * Validierungs-Dashboard. Die Nummerierung hat Luecken: H·03 und H·04 wurden
 * im Verlauf verworfen. Die Luecken bleiben stehen, weil eine glattgezogene
 * Reihe so tut, als haette es die beiden nie gegeben.
 */
const hypothesen = [
  {
    id: 'H·01',
    titel: 'Wahrnehmungsdefizit',
    text: 'Menschen bewerten ihr Leben als „gut“, können aber kaum konkrete Glücksmomente benennen.',
  },
  {
    id: 'H·02',
    titel: 'Dopamin-Substitution',
    text: 'Digitaler Konsum wird als Ersatz für echte Glücksmomente genutzt, mit abnehmendem Ertrag.',
  },
  {
    id: 'H·05',
    titel: 'Stadien-Entwicklung',
    text: 'Selbstoptimierungs-Apps erzeugen Druck statt nachhaltiger Veränderung.',
  },
  {
    id: 'H·06',
    titel: 'Design-to-Delete',
    text: 'Nutzer wünschen sich eine App, die Selbstständigkeit fördert statt Abhängigkeit.',
  },
  {
    id: 'H·07',
    titel: 'Innen-Außen-Diskrepanz',
    text: 'Menschen bewerten ihr Leben nach außen besser, als es sich innen anfühlt. Diese Diskrepanz geht mit einer geringeren Wahrnehmungsfähigkeit für positive Momente einher.',
  },
];
---

<AntipolLayout
  title="Momance - Experiment 02"
  description="Ein Wahrnehmungstraining, das sich selbst überflüssig macht."
  activePage="experimente">

  <!-- ============ CONTAINER 1: Was ist das ============ -->
  <section class="panel panel-dark" aria-label="Momance - worum es geht">
    <div class="container mit-bild">
      <div class="spalte-text">
        <div class="section-label fade-in">
          <a href="/experimente" class="zurueck">Experimente</a> · 02
        </div>
        <h1 class="fade-in">Momance</h1>
        <p class="einzeiler fade-in">Ein Wahrnehmungstraining, das sich selbst überflüssig macht.</p>
        <p class="fade-in">Eine App gegen die Gewohnheit, das Gute zu übersehen. Sie verordnet keine Dankbarkeit, sie trainiert die Wahrnehmung. Und sie ist darauf angelegt, irgendwann gelöscht zu werden.</p>
        <p class="fade-in">Ein Experiment von ANTIPOL, seit April 2026 in Arbeit.</p>
        <p class="zustand fade-in fade-in-delay">Noch nicht öffentlich. Was hier steht, ist der Stand von heute.</p>
      </div>
      <div class="spalte-bild puls-quadrat fade-in fade-in-delay">
        <MomancePuls />
      </div>
    </div>
  </section>

  <!-- ============ CONTAINER 2: Hypothesen ============ -->
  <section class="panel panel-mid" aria-label="Was geprüft wird">
    <div class="container">
      <div class="section-label fade-in">Was wir prüfen</div>
      <h2 class="fade-in">Fünf Hypothesen aus der Nutzerbefragung</h2>
      <ol class="hypothesen" role="list">
        {hypothesen.map((h) => (
          <li class="hypothese fade-in">
            <span class="h-nr" aria-hidden="true">{h.id}</span>
            <div class="h-inhalt">
              <h3>{h.titel}</h3>
              <p>{h.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="luecke fade-in">H·03 und H·04 wurden im Verlauf verworfen. Die Lücken bleiben stehen.</p>
    </div>
  </section>

</AntipolLayout>

<style>
  /* === PANEL === */
  .panel {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: 7rem 4rem 5rem;
    position: relative;
  }
  .panel-dark { background: var(--color-bg); }
  .panel-mid { background: var(--color-surface); border-top: 1px solid rgba(58,58,58,0.4); }
  @media (max-width: 768px) {
    .panel { min-height: auto; padding: 5rem 1.5rem 3.5rem; }
  }

  /* === CONTAINER === */
  .container { width: 100%; max-width: 1100px; margin: 0 auto; }
  .container.mit-bild {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4.5rem; align-items: center;
  }
  @media (max-width: 900px) {
    .container.mit-bild { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* === TYPOGRAFIE === */
  .section-label {
    font-family: var(--font-mono);
    font-size: var(--size-label); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-primary-accessible); margin-bottom: 1.2rem;
  }
  .zurueck { color: inherit; text-decoration: none; border-bottom: 1px solid var(--color-text-label); }
  .zurueck:hover { color: var(--color-primary-light); border-bottom-color: var(--color-primary-light); }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600;
    letter-spacing: -0.03em; line-height: 1.05;
    color: var(--color-text-pure); margin: 0 0 0.6rem;
  }
  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem); font-weight: 600;
    letter-spacing: -0.025em; line-height: 1.15;
    color: var(--color-text-pure); margin: 0 0 2.4rem;
  }
  .einzeiler {
    font-family: var(--font-display); font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 500; color: var(--color-primary-accessible);
    margin: 0 0 1.4rem; letter-spacing: -0.01em;
  }
  .spalte-text p {
    font-size: var(--size-copy); color: var(--color-text-muted);
    line-height: var(--line-height-copy); margin: 0 0 0.9rem;
  }
  /* Statt eines toten Knopfes: der Zustand, an derselben Stelle wie bei
     Mantrify der Link. */
  .zustand {
    margin: 1.6rem 0 0 !important;
    padding-left: 1rem; border-left: 2px solid var(--color-primary);
    font-family: var(--font-mono) !important; font-size: var(--size-label) !important;
    letter-spacing: 0.04em; line-height: 1.75 !important;
    color: var(--color-text-label) !important;
  }

  /* === BILD ===
     Der Puls kommt quer aus der Komponente und wird hier auf quadratisch
     gestellt, damit er die rechte Haelfte fuellt.

     Bewusst ohne sichtbare Kante: Der Puls ist ein Motiv, das nach aussen
     ausklingt, kein Bild mit Rand. Ein Rahmen wuerde ihm eine Grenze geben,
     die die Zeichnung selbst nicht hat. Das Feld traegt deshalb nur seinen
     eigenen Grund. */
  .spalte-bild { overflow: hidden; }
  .puls-quadrat :global(.puls-kachel) {
    aspect-ratio: 1 / 1;
    /* Die Komponente bringt fuer die Uebersichtskachel ein eigenes #0A0A0E
       mit. Das ist zwei Nuancen dunkler als der Panelgrund und zeichnet
       deshalb genau die Kante, die hier nicht sein soll. Der Zeichencode
       raeumt das Canvas mit clearRect, malt also keinen Grund; transparent
       ist damit gefahrlos und traegt jeden Panelhintergrund. */
    background: transparent;

    /* Der Schein, den die Zeichnung selbst legt, laeuft bis an die
       Canvas-Kante und ergibt dort wieder ein sichtbares Rechteck. Die Maske
       blendet ihn kreisfoermig aus. closest-side, damit die Blende an der
       Seitenmitte endet und nicht erst in den Ecken; sonst bleibt ein
       Achteck stehen. Ab 66 Prozent, das liegt hinter dem aeussersten Ring,
       es wird also nichts von der Zeichnung angeschnitten. */
    -webkit-mask-image: radial-gradient(circle closest-side at 50% 50%, #000 66%, transparent 100%);
    mask-image: radial-gradient(circle closest-side at 50% 50%, #000 66%, transparent 100%);
  }

  /* === HYPOTHESEN === */
  .hypothesen { list-style: none; margin: 0; padding: 0; max-width: 860px; }
  .hypothese {
    display: grid; grid-template-columns: 4.6rem 1fr; gap: 0 1.4rem;
    padding: 1.4rem 0; border-top: 1px solid var(--color-border);
  }
  .hypothese:last-child { border-bottom: 1px solid var(--color-border); }
  .h-nr {
    font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.04em;
    line-height: 1.9; color: var(--color-text-label);
  }
  .h-inhalt h3 {
    font-family: var(--font-display); font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    font-weight: 600; letter-spacing: -0.015em;
    color: var(--color-text-light); margin: 0 0 0.5rem; line-height: 1.3;
  }
  .h-inhalt p {
    font-size: var(--size-copy); color: var(--color-text-muted);
    line-height: var(--line-height-copy); margin: 0;
  }
  .luecke {
    font-family: var(--font-mono); font-size: var(--size-label);
    color: var(--color-text-label); margin: 1.2rem 0 0; max-width: 860px;
  }
  @media (max-width: 600px) {
    .hypothese { grid-template-columns: 1fr; gap: 0.3rem; }
    .h-nr { line-height: 1.4; }
  }
</style>

---
/**
 * Verteiler für die Experimente.
 *
 * Bis zum 11.08.2026 lag hier die gesamte Momance-Fallstudie. Mit dem zweiten
 * Experiment wurde daraus ein Verteiler: Jedes Experiment bekommt eine eigene
 * Adresse, damit man einzeln darauf verlinken kann, und keines verschwindet
 * mehr unter der Länge des anderen.
 *
 * Zweite Fassung: keine Spalten mehr, sondern volle Breite und gestapelt.
 * Bildanteil statt reiner Textkachel, beide Bilder sind echte Stände. Die
 * Einladung ist kein drittes Experiment mehr.
 *
 * Dritte Fassung, 15.08.2026, nach Feedback von Stefan und Catrin: Die Seite
 * ist eine Übersicht, keine Abfolge. Wer sie betritt, soll Kurzbeschreibung
 * und beide Teaser gleichzeitig sehen, ohne zu scrollen.
 *
 * - Der Kopf hatte min-height 100vh und füllte damit zwangsläufig den ersten
 *   Bildschirm allein. Das war der eigentliche Grund, warum nichts gemeinsam
 *   sichtbar war, nicht die Höhe der Teaser. Jetzt normaler Dokumentfluss.
 * - Die Metazeile (Typ, Zeitraum, Status) ist raus. Sie steht auf den
 *   Detailseiten, wo sie hingehört. In der Übersicht kostete sie vier Zeilen
 *   pro Teaser für eine Information, nach der auf dieser Ebene niemand fragt.
 * - Die Beschreibung ist auf einen Satz gekürzt. Weggefallen sind bei Momance
 *   „Dokumentiert vom ersten Missverständnis an", bei Mantrify „Ein Gadget
 *   gegen den Moment, nicht gegen das Problem" und „Arbeitstitel, und die
 *   einzige Kennzahl ist das Teilen". Beides steht auf den Detailseiten. Der
 *   zweite Satz kostete jeweils eine Zeile, und an diesen Zeilen hing, ob die
 *   Einladung auf einem 14-Zoll-Fenster noch ins Bild passt (898 Pixel gegen
 *   etwa 880 verfügbare). Wenn ihr die Sätze zurückwollt, ist das die Stelle.
 * - Das Bild bekommt eine feste schmale Spalte statt fast der halben Breite.
 *   Damit wird aus einem Band von rund 400 Pixeln eines von etwa 180.
 * - Der Pfeil sitzt jetzt in der Überschrift statt in einer eigenen Zeile.
 *   Spart Höhe und macht deutlicher, dass der Name das Ziel ist.
 * - Die Einladung ist eine gestrichelte Zeile. Sie bleibt bewusst unter den
 *   beiden Experimenten: Die Seite behauptet „wir bauen", der Beleg gehört vor
 *   das Angebot. Durch das flachere Layout steht sie trotzdem im ersten Bild.
 * - Die Zeile zum Radical Empathy Process steht jetzt unter der Liste. Sie
 *   ordnet ein, was man gesehen hat, statt vorab zu erklären, was kommt.
 *
 * Farben: Alle Werte auf dieser Seite sind gegen ihre tatsächliche Fläche
 * gemessen. Die Karten liegen auf --color-surface, nicht auf einer
 * halbtransparenten Aufhellung; nur so ist der Kontrast überhaupt berechenbar.
 * Gegenüber der zweiten Fassung wurde kein Farbwert verändert, nur Grösse und
 * Anordnung. Geprüft mit design-system/pruefen.mjs.
 */
import AntipolLayout from '../../layouts/AntipolLayout.astro';

const experimente = [
  {
    nummer: '01',
    name: 'Momance',
    einzeiler: 'Ein Wahrnehmungstraining, das sich selbst überflüssig macht.',
    beschreibung:
      'Eine App gegen die Gewohnheit, das Gute zu übersehen.',
    href: '/experimente/momance',
    bild: '/bilder/momance-landing.webp',
    alt: 'Der Kopf der Momance-Website: die Zeile „Eine App, die will, dass du sie löschst" neben der pulsierenden grünen Bildmarke auf schwarzem Grund.',
  },
  {
    nummer: '02',
    name: 'Mantrify',
    einzeiler: 'Hilft jetzt. Ändert nix.',
    beschreibung:
      'Ein Würfel trägt einen Gedanken in fünf Stimmen.',
    href: '/experimente/mantrify',
    bild: '/bilder/mantrify-wuerfel.webp',
    alt: 'Der Prototyp von Mantrify: ein goldener Würfel mit dem Satz „Ich trenne, was in meinem Einfluss liegt und was nicht", darüber der gezeichnete Kopf der Figur „Dein Therapeut".',
  },
];
---

<AntipolLayout
  title="Experimente"
  description="Wir reden nicht nur. Wir bauen. Zwei laufende Experimente, unaufgeräumt dokumentiert."
  activePage="experimente"
>
  <section class="uebersicht" aria-label="Experimente">
    <div class="kopf">
      <div class="section-label fade-in">Experimente</div>
      <h1 class="fade-in">Wir reden nicht nur.<br />Wir bauen.</h1>
      <p class="intro fade-in">
        Wer anderen empfiehlt zu experimentieren, muss das selbst können. Hier ist der Beweis,
        unaufgeräumt.
      </p>
    </div>

    <div class="liste">
      {
        experimente.map((e) => (
          <article class="spur fade-in">
            <div class="spur-text">
              <p class="spur-label">Experiment {e.nummer}</p>
              <h2>
                <a href={e.href}>
                  {e.name}
                  <span class="pfeil" aria-hidden="true" />
                </a>
              </h2>
              <p class="spur-einzeiler">{e.einzeiler}</p>
              <p class="spur-beschreibung">{e.beschreibung}</p>
            </div>

            <div class="spur-bild">
              <img src={e.bild} alt={e.alt} width="1600" height="900" loading="lazy" decoding="async" />
            </div>
          </article>
        ))
      }

      {/*
        Die Einladung ist bewusst kein drittes Experiment: keine Nummer, kein
        Bild, keine eigene Karte, sondern eine Zeile. Gestrichelt und ohne
        Fläche, damit sie nach freiem Platz aussieht und nicht nach einem
        Angebot, das man gerade noch untergebracht hat.
      */}
      <a class="einladung fade-in" href="/#kontakt">
        <span class="einladung-label">Experiment starten</span>
        <span class="einladung-text">
          Das nächste Experiment hat noch keinen Namen. Bringt uns eure Annahme.
        </span>
        <span class="pfeil" aria-hidden="true"></span>
      </a>

      <p class="why-line fade-in">
        Jedes Experiment folgt <a href="/fokus"
          >The Radical Empathy &amp; Experimentation Process<span class="tm">™</span></a
        >. Kein aufgeräumter Erfolgsnachweis, sondern ein ehrlicher Bericht davon, welcher Schritt
        welche Entscheidung erzeugt hat.
      </p>
    </div>
  </section>
</AntipolLayout>

<style>
  /* === SEITE ===
     Ein einziger Abschnitt statt Kopf-Panel plus Listen-Panel. Vorher hatte der
     Kopf min-height 100vh; damit lag die Liste per Definition unterhalb der
     Bildkante, egal wie flach die Teaser wurden. */
  .uebersicht {
    background: var(--color-bg);
    padding: clamp(5.5rem, 11vh, 7rem) 4rem clamp(3.5rem, 8vh, 5rem);
  }

  .kopf,
  .liste {
    max-width: 1180px;
    margin: 0 auto;
  }

  .kopf {
    max-width: 1180px;
    margin-bottom: clamp(1.5rem, 3vh, 2.25rem);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary-accessible);
    margin-bottom: 1rem;
  }

  .kopf h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-pure);
    margin-bottom: 1rem;
  }

  /* Copy: eine Groesse, eine Farbe. Werte kommen aus den Tokens, damit es
     nicht wieder auseinanderlaeuft. */
  .kopf .intro {
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    max-width: 62ch;
    margin: 0;
  }

  /* === LISTE === */
  .liste {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.8vw, 1.25rem);
  }

  /* === EINE SPUR ===
     Volle Breite, gestapelt. Kein Raster aus Kacheln: das bricht bei jeder
     neuen Zeile anders um und zwingt alle Kacheln auf dieselbe Hoehe.
     Das Bild steht in einer schmalen festen Spalte, damit die Bandhoehe vom
     Text bestimmt wird und nicht vom Seitenverhaeltnis des Bildes. */
  .spur {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(190px, 23%, 270px);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1rem, 1.8vw, 1.35rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    transition: border-color var(--transition-base);
  }

  .spur:hover {
    border-color: var(--color-primary-light);
  }

  /* Der Link liegt auf der Überschrift und wird über die ganze Spur gestreckt.
     Waere die gesamte Kachel ein <a>, laese eine Sprachausgabe den kompletten
     Absatz als Linktext vor. So heisst der Link "Momance" beziehungsweise
     "Mantrify". */
  .spur h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.35rem 0 0;
  }

  .spur h2 a {
    color: var(--color-text-pure);
    text-decoration: none;
  }

  .spur h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }

  .spur h2 a:hover {
    color: var(--color-primary-accessible);
    text-decoration: none;
  }

  /* Der Fokusring gehört sichtbar an die ganze Spur, nicht nur an zwei Worte. */
  .spur:has(a:focus-visible) {
    outline: 2px solid var(--color-primary-accessible);
    outline-offset: 3px;
    border-color: var(--color-primary-accessible);
  }

  .spur h2 a:focus-visible {
    outline: none;
  }

  /* Der Pfeil sass vorher in einer eigenen Zeile unter dem Text. In der
     Uebersicht kostet das eine Zeile pro Teaser fuer ein Zeichen; jetzt haengt
     er am Namen. aria-hidden, weil die Ueberschrift schon der Link ist. */
  .pfeil {
    display: inline-block;
    transition: transform var(--transition-base);
  }

  .pfeil::after {
    content: '\2192';
    margin-left: 0.3em;
  }

  .spur:hover .pfeil,
  .einladung:hover .pfeil {
    transform: translateX(4px);
  }

  /* Mono, 12px, --color-text-label: 5,14 zu 1 auf dieser Flaeche. */
  .spur-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-label);
    margin: 0;
  }

  /* Gleiche Groesse wie jeder andere Copy-Text. Der Einzeiler hebt sich ueber
     die Akzentfarbe ab, nicht ueber Pixel. */
  .spur-einzeiler {
    font-family: var(--font-body);
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-primary-accessible);
    margin: 0.4rem 0 0;
  }

  .spur-beschreibung {
    font-family: var(--font-body);
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    margin: 0.5rem 0 0;
    max-width: 62ch;
  }

  /* === BILD === */
  .spur-bild {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    line-height: 0;
  }

  .spur-bild img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* === EINLADUNG ===
     Eine Zeile, keine Karte. Gestrichelt und ohne Flaeche, damit sie nach
     freiem Platz aussieht. Der Strichrahmen ist die einzige Information, die
     hier an einer Farbe haengt, deshalb haelt er 3 zu 1 (#6E6862 auf #0D0D0D
     = 3,53). */
  .einladung {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(0.9rem, 1.8vw, 1.15rem) clamp(1.1rem, 2vw, 1.5rem);
    border: 1px dashed #6e6862;
    border-radius: 14px;
    text-decoration: none;
    transition: border-color var(--transition-base);
  }

  .einladung:hover {
    border-color: var(--color-primary-light);
    text-decoration: none;
  }

  .einladung:focus-visible {
    outline: 2px solid var(--color-primary-accessible);
    outline-offset: 3px;
    border-color: var(--color-primary-accessible);
  }

  .einladung-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary-accessible);
    flex: none;
  }

  .einladung-text {
    font-family: var(--font-body);
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    max-width: 90ch;
  }

  .einladung .pfeil {
    margin-left: auto;
    color: var(--color-primary-accessible);
    flex: none;
  }

  /* === EINORDNUNG ===
     Steht unter der Liste, weil sie erklaert, wie das Gezeigte entstanden ist.
     Vorher stand sie im Kopf und kostete dort die Hoehe, die jetzt der zweite
     Teaser hat. */
  .why-line {
    font-size: var(--size-ui);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    max-width: 68ch;
    margin: clamp(0.75rem, 2vh, 1.25rem) 0 0;
  }

  .why-line a {
    color: var(--color-primary-accessible);
    text-decoration: none;
    border-bottom: 1px solid rgba(224, 122, 66, 0.4);
    transition: border-color 0.2s;
  }

  .why-line a:hover {
    border-bottom-color: rgba(224, 122, 66, 0.9);
    text-decoration: none;
  }

  .tm {
    font-size: 0.55em;
    vertical-align: super;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* === RESPONSIV === */
  @media (max-width: 900px) {
    .uebersicht {
      padding: 5.5rem 1.5rem 3.5rem;
    }

    .spur {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    /* Auf schmalen Geräten steht das Bild oben: es erklärt in einer Sekunde,
       worum es geht, wofür der Text drei Zeilen braucht. Die Vorlesereihenfolge
       bleibt Text zuerst, weil das Bild nur wiederholt, was dort steht. */
    .spur-bild {
      order: -1;
    }

    .spur-beschreibung {
      max-width: none;
    }

    /* Die Einladung bricht auf zwei Zeilen um. Der Pfeil rutscht dabei neben
       das Label, nicht in eine dritte Zeile. */
    .einladung {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }

    .einladung-text {
      order: 3;
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spur:hover .pfeil,
    .einladung:hover .pfeil {
      transform: none;
    }
  }
</style>

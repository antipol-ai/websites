---
/**
 * Verteiler für die Experimente.
 *
 * Bis zum 11.08.2026 lag hier die gesamte Momance-Fallstudie. Mit dem zweiten
 * Experiment wurde daraus ein Verteiler: Jedes Experiment bekommt eine eigene
 * Adresse, damit man einzeln darauf verlinken kann, und keines verschwindet
 * mehr unter der Länge des anderen.
 *
 * Zweite Fassung, nach Feedback von Stefan:
 *
 * - Keine Spalten mehr, sondern volle Breite und gestapelt. Ein Raster aus
 *   drei Kacheln bricht bei jeder neuen Zeile anders um und zwingt alle
 *   Kacheln auf dieselbe Höhe. Gestapelte Bänder tragen responsiv besser und
 *   lassen jedes Experiment so lang sein, wie es ist.
 * - Bildanteil statt reiner Textkachel. Beide Bilder sind echte Stände, keine
 *   Attrappen: der gerenderte Würfel aus der Mantrify-Microsite und der Kopf
 *   der ausgelieferten Momance-Seite.
 * - Die Einladung ist kein drittes Experiment mehr. Sie trug vorher die Nummer
 *   03, was bei jedem echten dritten Experiment hätte nachgezogen werden
 *   müssen. Jetzt ist sie ein Teaser in eigenem Format, ohne Nummer, ohne
 *   Bild, ohne Metazeile.
 *
 * Farben: Alle Werte auf dieser Seite sind gegen ihre tatsächliche Fläche
 * gemessen. Die Karten liegen auf --color-surface, nicht auf einer
 * halbtransparenten Aufhellung; nur so ist der Kontrast überhaupt berechenbar.
 * Geprüft mit design-system/pruefen.mjs.
 */
import AntipolLayout from '../../layouts/AntipolLayout.astro';

const experimente = [
  {
    nummer: '01',
    name: 'Momance',
    einzeiler: 'Ein Wahrnehmungstraining, das sich selbst überflüssig macht.',
    beschreibung:
      'Eine App gegen die Gewohnheit, das Gute zu übersehen. Entstanden im Sparring mit einer KI, dokumentiert vom ersten Missverständnis an.',
    typ: 'Produktentwicklung mit AI',
    zeitraum: 'Seit März 2026',
    status: 'In Entwicklung, Phase 1',
    href: '/experimente/momance',
    bild: '/bilder/momance-landing.webp',
    alt: 'Der Kopf der Momance-Website: die Zeile „Eine App, die will, dass du sie löschst" neben der pulsierenden grünen Bildmarke auf schwarzem Grund.',
  },
  {
    nummer: '02',
    name: 'Mantrify',
    einzeiler: 'Hilft jetzt. Ändert nix.',
    beschreibung:
      'Ein Würfel trägt einen Gedanken in fünf Stimmen. Ein Gadget gegen den Moment, nicht gegen das Problem. Arbeitstitel, und die einzige Kennzahl ist das Teilen.',
    typ: 'Produktexperiment, digital und physisch',
    zeitraum: 'Seit August 2026',
    status: 'Prototyp, nicht veröffentlicht',
    href: '/experimente/mantrify',
    bild: '/bilder/mantrify-wuerfel.webp',
    alt: 'Der Prototyp von Mantrify: ein goldener Würfel mit dem Satz „Ich trenne, was in meinem Einfluss liegt und was nicht", darüber der gezeichnete Kopf der Figur „Dein Therapeut".',
  },
];
---

<AntipolLayout
  title="Experimente"
  description="Wir reden nicht nur. Wir bauen. Zwei laufende Experimente, unaufgeräumt dokumentiert."
  activePage="experimente"
>
  <section class="panel panel-dark" id="hero" aria-label="Experimente, Einleitung">
    <div class="hero-content">
      <div class="section-label fade-in">Experimente</div>
      <h1 class="fade-in">Wir reden nicht nur.<br />Wir bauen.</h1>
      <p class="intro fade-in">
        Wer anderen empfiehlt zu experimentieren, muss das selbst können. Hier ist der Beweis,
        unaufgeräumt.
      </p>
      <p class="why-line fade-in fade-in-delay">
        Jedes Experiment folgt <a href="/fokus"
          >The Radical Empathy &amp; Experimentation Process<span class="tm">™</span></a
        >. Kein aufgeräumter Erfolgsnachweis, sondern ein ehrlicher Bericht davon, welcher Schritt
        welche Entscheidung erzeugt hat.
      </p>
    </div>
  </section>

  <section class="liste-panel" aria-label="Liste der Experimente">
    <div class="liste">
      {
        experimente.map((e) => (
          <article class="spur fade-in">
            <div class="spur-text">
              <p class="spur-label">Experiment {e.nummer}</p>
              <h2>
                <a href={e.href}>{e.name}</a>
              </h2>
              <p class="spur-einzeiler">{e.einzeiler}</p>
              <p class="spur-beschreibung">{e.beschreibung}</p>
              <dl class="spur-meta">
                <div>
                  <dt>Typ</dt>
                  <dd>{e.typ}</dd>
                </div>
                <div>
                  <dt>Zeitraum</dt>
                  <dd>{e.zeitraum}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>{e.status}</dd>
                </div>
              </dl>
              <p class="spur-cta" aria-hidden="true">Das Experiment ansehen</p>
            </div>

            <div class="spur-bild">
              <img src={e.bild} alt={e.alt} width="1600" height="900" loading="lazy" decoding="async" />
            </div>
          </article>
        ))
      }

      {/*
        Die Einladung ist bewusst kein drittes Experiment: keine Nummer, kein
        Bild, keine Metazeile, halbe Höhe. Sie soll wie freier Platz wirken und
        nicht wie ein Angebot, das man gerade noch untergebracht hat.
      */}
      <article class="spur spur-einladung fade-in">
        <div class="spur-text">
          <p class="spur-label">Experiment starten</p>
          <h2><a href="/#kontakt">Eure Frage</a></h2>
          <p class="spur-einzeiler">Das nächste Experiment hat noch keinen Namen.</p>
          <p class="spur-beschreibung">
            Wenn ihr eine Annahme habt, die sich nicht durch Nachdenken klären lässt, sondern nur
            durch Ausprobieren, dann ist das der Anfang. Wir bauen es mit euch und dokumentieren es
            genauso offen wie die beiden darüber.
          </p>
          <p class="spur-cta" aria-hidden="true">Schreibt uns</p>
        </div>
      </article>
    </div>
  </section>
</AntipolLayout>

<style>
  /* === PANEL === */
  /* Die Definitionen stehen hier lokal, weil Astro Styles scoped und es keine
     gemeinsame Panel-Klasse im Shared-Paket gibt. Werte identisch zu den
     Detailseiten, damit der Wechsel nicht springt. */
  .panel {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 4rem 4rem;
    position: relative;
  }

  .panel-dark {
    background: var(--color-bg);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary-accessible);
    margin-bottom: 1.5rem;
  }

  .tm {
    font-size: 0.55em;
    vertical-align: super;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-pure);
    margin-bottom: 1.5rem;
  }

  /* Copy: eine Groesse, eine Farbe. Vorher stand hier 1,1rem in Grau ueber
     0,95rem in Warmweiss, was sich wie eine Hierarchie las, die nicht gemeint
     war. Werte kommen aus den Tokens, damit es nicht wieder auseinanderlaeuft. */
  .hero-content .intro,
  .hero-content .why-line {
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .hero-content .intro {
    margin-bottom: 1.2rem;
  }

  .hero-content .why-line a {
    color: var(--color-primary-accessible);
    text-decoration: none;
    border-bottom: 1px solid rgba(224, 122, 66, 0.4);
    transition: border-color 0.2s;
  }

  .hero-content .why-line a:hover {
    border-bottom-color: rgba(224, 122, 66, 0.9);
    text-decoration: none;
  }

  /* === LISTE === */
  .liste-panel {
    background: var(--color-bg);
    padding: clamp(3rem, 8vh, 6rem) 4rem clamp(5rem, 12vh, 8rem);
  }

  .liste {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 2rem);
    max-width: 1180px;
    margin: 0 auto;
  }

  /* === EINE SPUR === */
  /* Volle Breite, gestapelt. Innerhalb der Spur stehen Text und Bild ab 900px
     nebeneinander; darunter fällt das Bild nach oben und der Text darunter. */
  .spur {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    transition: border-color var(--transition-base);
  }

  .spur:hover {
    border-color: var(--color-primary-light);
  }

  /* Der Link liegt auf der Überschrift und wird über die ganze Spur gestreckt.
     Vorher war die gesamte Kachel ein <a>; damit las eine Sprachausgabe den
     kompletten Absatz samt Metazeile als Linktext vor. Jetzt heisst der Link
     "Momance" beziehungsweise "Mantrify". */
  .spur h2 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0;
  }

  .spur h2 a {
    color: var(--color-text-pure);
    text-decoration: none;
  }

  .spur h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }

  .spur h2 a:hover {
    color: var(--color-primary-accessible);
    text-decoration: none;
  }

  /* Der Fokusring gehört sichtbar an die ganze Spur, nicht nur an zwei Worte. */
  .spur:has(a:focus-visible) {
    outline: 2px solid var(--color-primary-accessible);
    outline-offset: 3px;
    border-color: var(--color-primary-accessible);
  }

  .spur h2 a:focus-visible {
    outline: none;
  }

  /* Mono, 12px. Vorher 9,3px in #6B6158, also 2,88 zu 1 auf dieser Fläche.
     Jetzt 5,14 zu 1. */
  .spur-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-label);
    margin: 0;
  }

  /* Gleiche Groesse wie jeder andere Copy-Text. Der Einzeiler hebt sich ueber
     die Akzentfarbe ab, nicht ueber Pixel. */
  .spur-einzeiler {
    font-family: var(--font-body);
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-primary-accessible);
    margin: 0.6rem 0 0;
  }

  .spur-beschreibung {
    font-family: var(--font-body);
    font-size: var(--size-copy);
    line-height: var(--line-height-copy);
    color: var(--color-text-muted);
    margin: 1rem 0 0;
    max-width: 46ch;
  }

  .spur-meta {
    display: grid;
    gap: 0.55rem;
    margin: 1.6rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .spur-meta > div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .spur-meta dt {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-label);
    min-width: 6rem;
    flex: none;
  }

  /* Meta-Werte sind Bedienungsinformation, kein Fliesstext: --size-ui,
     genauso wie auf den Detailseiten. */
  .spur-meta dd {
    font-family: var(--font-body);
    font-size: var(--size-ui);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* aria-hidden, weil der eigentliche Link die Überschrift ist. Eine
     Sprachausgabe würde sonst zwei Ziele für dasselbe Ziel ansagen. */
  .spur-cta {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: var(--size-copy);
    font-weight: 500;
    color: var(--color-primary-accessible);
  }

  .spur-cta::after {
    content: '\2192';
    display: inline-block;
    margin-left: 0.4em;
    transition: transform var(--transition-base);
  }

  .spur:hover .spur-cta::after {
    transform: translateX(4px);
  }

  /* === BILD === */
  .spur-bild {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    line-height: 0;
  }

  .spur-bild img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* === EINLADUNG === */
  /* Kein Bild, keine Nummer, keine Metazeile. Gestrichelt und ohne Fläche,
     damit sie nach freiem Platz aussieht. Der Strichrahmen ist die einzige
     Information, die hier an einer Farbe hängt, deshalb hält er 3 zu 1
     (#6E6862 auf #0D0D0D = 3,53). */
  .spur-einladung {
    grid-template-columns: minmax(0, 1fr);
    background: none;
    border-style: dashed;
    border-color: #6e6862;
    padding: clamp(1.6rem, 3vw, 2.2rem) clamp(1.6rem, 3vw, 2.4rem);
  }

  .spur-einladung .spur-text {
    max-width: 62ch;
  }

  .spur-einladung h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
  }

  .spur-einladung h2 a {
    color: var(--color-text);
  }

  .spur-einladung .spur-einzeiler {
    color: var(--color-text-muted);
  }

  .spur-einladung .spur-beschreibung {
    max-width: none;
  }

  .spur-einladung:hover {
    border-color: var(--color-primary-light);
  }

  /* === RESPONSIV === */
  @media (max-width: 900px) {
    .panel {
      padding: 5rem 1.5rem 3rem;
    }

    .liste-panel {
      padding: 3rem 1.5rem 4rem;
    }

    .spur {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    /* Auf schmalen Geräten steht das Bild oben: es erklärt in einer Sekunde,
       worum es geht, wofür der Text drei Zeilen braucht. Die Vorlesereihenfolge
       bleibt Text zuerst, weil das Bild nur wiederholt, was dort steht. */
    .spur-bild {
      order: -1;
    }

    .spur-beschreibung {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spur:hover .spur-cta::after {
      transform: none;
    }
  }
</style>

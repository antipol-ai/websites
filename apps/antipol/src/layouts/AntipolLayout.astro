---
/**
 * AntipolLayout - ANTIPOL-spezifisches Layout.
 *
 * Importiert das BaseLayout, lädt ANTIPOL-Theme, Fonts und Navigation.
 */
import BaseLayout from '@antipol/shared/layouts/BaseLayout.astro';
import Nav from '@antipol/shared/components/Nav.astro';
import Footer from '@antipol/shared/components/Footer.astro';
import '@antipol/shared/styles/base.css';
import '@antipol/shared/styles/animations.css';
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description, activePage } = Astro.props;

const navLinks = [
  { label: 'Fokus', href: '/fokus', active: activePage === 'fokus' },
  { label: 'Experimente', href: '/experimente', active: activePage === 'experimente' },
  { label: 'Kontakt', href: '/#kontakt', active: activePage === 'kontakt' },
];

const footerLinks = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
];
---

<BaseLayout title={`ANTIPOL - ${title}`} description={description}>
  <Fragment slot="head">
    <!-- Schriften liegen lokal unter /fonts (siehe src/styles/fonts.css).
         Keine Verbindung zu Google, keine Übertragung von IP-Adressen. -->
    <link rel="preload" href="/fonts/space-grotesk-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <Nav
    slot="nav"
    brand="ANTI"
    brandHighlight="POL"
    brandHref="/"
    links={navLinks}
  />

  <slot />

  <Footer
    slot="footer"
    company="ANTI"
    companyHighlight="POL"
    companySuffix=" GbR"
    people="Stefan Bodeit & Catrin Schröder-Jaross · Hamburg"
    links={footerLinks}
  />
</BaseLayout>

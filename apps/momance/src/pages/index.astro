---
import MomanceLayout from '../layouts/MomanceLayout.astro';
import Hero from '@antipol/shared/components/Hero.astro';
import Card from '@antipol/shared/components/Card.astro';
import CTA from '@antipol/shared/components/CTA.astro';
---

<MomanceLayout
  title="Dein Wahrnehmungstraining"
  description="Halte fest, was dich bewegt. Entdecke Muster in deiner Wahrnehmung."
  activePage="home"
>
  <Hero layout="centered">
    <p class="hero-eyebrow fade-in">Wahrnehmungstraining</p>
    <h1 class="hero-title fade-in">Momance</h1>
    <p class="hero-subtitle fade-in">
      Halte fest, was dich bewegt.
    </p>
    <p class="hero-body fade-in">
      Nicht um festzuhalten — sondern um bewusster wahrzunehmen.
      Momance begleitet dich auf dem Weg zu einer tieferen,
      reicheren Wahrnehmung deines Alltags.
    </p>
  </Hero>

  <section class="section" id="wie-es-funktioniert">
    <p class="section-eyebrow fade-in">Die Idee</p>
    <h2 class="section-title fade-in">
      Eine App, die sich selbst überflüssig macht
    </h2>
    <p class="section-body fade-in">
      Momance ist kein weiteres Achtsamkeits-Tool, das dich an den
      Bildschirm fesselt. Es ist ein Wahrnehmungstraining.
    </p>

    <div class="dimensions-grid fade-in fade-in-delay">
      <Card><h3>Tiefe</h3><p>Wie intensiv nimmst du einzelne Momente wahr?</p></Card>
      <Card><h3>Breite</h3><p>Wie vielfältig sind die Bereiche, die dich berühren?</p></Card>
      <Card><h3>Spontaneität</h3><p>Wie schnell erkennst du, wenn etwas Besonderes passiert?</p></Card>
      <Card><h3>Autonomie</h3><p>Wie eigenständig gestaltest du bewusste Momente?</p></Card>
    </div>
  </section>

  <CTA
    overline="Bald verfügbar"
    headline="Bereit, bewusster wahrzunehmen?"
  >
    <span class="coming-soon">Coming Soon</span>
  </CTA>
</MomanceLayout>

<style>
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary-muted);
    margin-bottom: 24px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 400;
    font-style: italic;
    color: var(--color-primary);
    margin-bottom: 20px;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 16px;
    max-width: 560px;
  }

  .hero-body {
    font-size: 16px;
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: 48px;
    line-height: 1.7;
  }

  .section {
    max-width: 800px;
    margin: 0 auto;
    padding: 100px 24px;
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary-muted);
    margin-bottom: 16px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 32px;
    line-height: 1.2;
  }

  .section-body {
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .dimensions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 600px) {
    .dimensions-grid { grid-template-columns: 1fr; }
  }

  .coming-soon {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--color-primary);
    border: 1px solid var(--color-primary-muted);
    padding: 14px 36px;
    border-radius: var(--radius-full);
  }
</style>

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ANTIPOL Foundation - Geteilte Tokens fur alle Brands und Plattformen",

  "spacing": {
    "xs":  { "$value": "0.5rem",  "$description": "8px" },
    "sm":  { "$value": "1rem",    "$description": "16px" },
    "md":  { "$value": "1.5rem",  "$description": "24px" },
    "lg":  { "$value": "2.5rem",  "$description": "40px" },
    "xl":  { "$value": "4rem",    "$description": "64px" },
    "2xl": { "$value": "6rem",    "$description": "96px" }
  },

  "radii": {
    "sm":   { "$value": "3px" },
    "md":   { "$value": "4px" },
    "lg":   { "$value": "16px" },
    "full": { "$value": "50px" }
  },

  "transitions": {
    "fast": { "$value": "0.2s ease" },
    "base": { "$value": "0.3s ease" },
    "slow": { "$value": "0.8s ease" }
  },

  "layout": {
    "content-max-width":    { "$value": "1200px" },
    "content-padding":      { "$value": "4rem" },
    "content-padding-mobile": { "$value": "1.5rem" }
  },

  "z-index": {
    "base":    { "$value": 1 },
    "nav":     { "$value": 100 },
    "overlay": { "$value": 200 },
    "modal":   { "$value": 300 }
  },

  "breakpoints": {
    "mobile":  { "$value": "768px" },
    "tablet":  { "$value": "1024px" },
    "desktop": { "$value": "1200px" }
  },

  "accessibility": {
    "minimum-contrast": { "$value": "4.5:1", "$description": "WCAG 2.1 AA - Normaler Text" },
    "large-text-contrast": { "$value": "3:1", "$description": "WCAG 2.1 AA - Grosser Text (>=18px bold oder >=24px)" },
    "focus-outline-width": { "$value": "2px" },
    "focus-outline-offset": { "$value": "3px" },
    "minimum-touch-target": { "$value": "44px", "$description": "iOS HIG / WCAG 2.5.8" }
  }
}

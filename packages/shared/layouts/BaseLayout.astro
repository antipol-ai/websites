---
/**
 * BaseLayout - Shared HTML-Grundgerüst für beide Sites.
 *
 * Lädt: Reset, Tailwind, Tokens, Animations.
 * Die App-spezifische theme.css wird per Slot oder Import im jeweiligen
 * App-Layout (AntipolLayout / MomanceLayout) geladen.
 */
interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** Pfad zum Teilen-Bild, relativ zur Site. Ohne Angabe wird keins gesetzt. */
  image?: string;
}

const { title, description = '', lang = 'de', image } = Astro.props;

/**
 * Kanonische Adresse.
 *
 * Der Grund steht im Vercel-Dashboard: Jedes Projekt ist zusaetzlich unter
 * seiner vercel.app-Adresse erreichbar, und ohne Canonical sind das zwei
 * vollstaendige Kopien derselben Site. Astro.site kommt aus astro.config.mjs,
 * ist also je App die richtige Domain.
 */
const kanonisch = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const bildAbsolut = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {kanonisch && <link rel="canonical" href={kanonisch} />}

  {/* Vorschau beim Teilen. Eine Seite, die weitergegeben werden soll, wird
      ueber diese Karte weitergegeben und nicht ueber ihre URL. */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : lang} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {kanonisch && <meta property="og:url" content={kanonisch} />}
  {bildAbsolut && <meta property="og:image" content={bildAbsolut} />}
  {bildAbsolut && <meta property="og:image:width" content="1200" />}
  {bildAbsolut && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={bildAbsolut ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  {bildAbsolut && <meta name="twitter:image" content={bildAbsolut} />}

  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">Zum Inhalt springen</a>
  <slot name="nav" />
  <main id="main">
    <slot />
  </main>
  <slot name="footer" />
  <script>
    // Shared IntersectionObserver for fade-in animations
    const fadeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.fade-in').forEach(el => fadeObserver.observe(el));
  </script>
  <slot name="scripts" />
</body>
</html>

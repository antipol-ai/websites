---
/**
 * Footer - Shared Footer.
 */
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  company: string;
  companyHighlight?: string;
  people?: string;
  links: FooterLink[];
}

const { company, companyHighlight, people, links } = Astro.props;
---

<footer role="contentinfo">
  <div class="footer-left">
    <div class="footer-company">
      {company}{companyHighlight && <span class="pol">{companyHighlight}</span>}
    </div>
    {people && <div class="footer-people">{people}</div>}
  </div>
  <div class="footer-right">
    {links.map((link, i) => (
      <>
        <a href={link.href}>{link.label}</a>
        {i < links.length - 1 && <span class="footer-divider" aria-hidden="true">/</span>}
      </>
    ))}
  </div>
</footer>

<style>
  footer {
    padding: 2rem var(--content-padding);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-company {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .footer-company .pol {
    color: var(--color-primary);
  }

  .footer-people {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-footer-meta);
    letter-spacing: 0.03em;
  }

  .footer-right {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .footer-right a {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-footer-text);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color var(--transition-fast);
  }

  .footer-right a:hover {
    color: var(--color-text-pure);
    text-decoration: none;
  }

  .footer-divider {
    color: var(--color-border);
    font-size: 0.7rem;
    user-select: none;
  }

  @media (max-width: 768px) {
    footer {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

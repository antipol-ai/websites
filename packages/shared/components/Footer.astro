---
/**
 * Footer - Shared Footer.
 */
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  company: string;
  companyHighlight?: string;
  companySuffix?: string;
  people?: string;
  links: FooterLink[];
}

const { company, companyHighlight, companySuffix = '', people, links } = Astro.props;
---

<footer role="contentinfo">
  <div class="footer-left">
    <div class="footer-company">
      {company}{companyHighlight && <span class="pol">{companyHighlight}</span>}{companySuffix}
    </div>
    {people && <div class="footer-people">{people}</div>}
  </div>
  <div class="footer-right">
    {links.map((link, i) => (
      <>
        <a href={link.href}>{link.label}</a>
        {i < links.length - 1 && <span class="footer-divider" aria-hidden="true">/</span>}
      </>
    ))}
  </div>
</footer>

<style>
  footer {
    padding: 2rem var(--content-padding);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-company {
    font-family: var(--font-display);
    font-size: var(--size-ui);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* Ziegelrot, in jeder Grösse (14.08.2026, MC·317). Hier stand der hellere Ton,
     weil die Zeile 13,6 Pixel gross ist und damit als kleiner Text gilt. Die
     Kontrastanforderung greift für einen Markennamen aber nicht (WCAG 1.4.3),
     und eine Marke, deren Farbe von der Grösse abhängt, ist keine.
     Der Rechtsformzusatz gehört ausdrücklich nicht in die Auszeichnung, dafür
     gibt es companySuffix. */
  .footer-company .pol {
    color: var(--color-primary);
  }

  .footer-people {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    color: var(--color-footer-meta);
    letter-spacing: 0.03em;
  }

  .footer-right {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .footer-right a {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    color: var(--color-footer-text);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color var(--transition-fast);
  }

  .footer-right a:hover {
    color: var(--color-text-pure);
    text-decoration: none;
  }

  .footer-divider {
    color: var(--color-border);
    font-size: var(--size-label);
    user-select: none;
  }

  @media (max-width: 768px) {
    footer {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>
